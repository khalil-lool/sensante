generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Ajoute cette ligne ci-dessous :
  url      = env("DATABASE_URL")
}

enum Role {
  AGENT
  MEDECIN
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  nom       String
  prenom    String
  email     String   @unique
  password  String
  role      Role     @default(AGENT)
  createdAt DateTime @default(now())
  // N'oublie pas d'ajouter la relation avec Consultation ici 
  // si tu passes au Lab v0.4
  consultations Consultation[]
}

// Ajoute le modèle Consultation pour ton Lab actuel (v0.4)
model Consultation {
  id           Int      @id @default(autoincrement())
  date         DateTime @default(now())
  symptomes    Json     // Stockage en JSON comme demandé
  notes        String?
  statut       String   @default("en_attente")
  
  patientId    Int
  patient      Patient  @relation(fields: [patientId], references: [id])
  
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
}

// N'oublie pas le modèle Patient si ce n'est pas déjà fait
model Patient {
  id            Int            @id @default(autoincrement())
  nom           String
  prenom        String
  region        String
  consultations Consultation[]
}